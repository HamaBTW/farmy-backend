PORT=3001
NODE_ENV=development
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=farmy
# Keep false for stable environments; enable only for local bootstrap experiments.
DB_SYNCHRONIZE=false
# Optional SQL logging toggle.
DB_LOGGING=false
JWT_SECRET=your_jwt_secret

# Email Configuration
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_app_password
EMAIL_FROM="Farmy <your_email@example.com>"

# OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_IOS_CLIENT_ID=your_google_ios_client_id
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Stripe Configuration
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
# Keep Stripe API versions consistent between server and mobile integrations.
STRIPE_API_VERSION=2024-04-10

# Hedera Configuration
HEDERA_NETWORK=testnet
HEDERA_ACCOUNT_ID=hedera_account_id
HEDERA_PRIVATE_KEY=hedera_private_key
HEDERA_TOPIC_ID=hedera_topic_id

# Gemini Api Key
GEMINI_API_KEY=gemini_api_key
AI_TIMEOUT=10000
AI_MAX_RETRIES=2
AI_CACHE_TTL=86400
GEMINI_TEXT_MODEL=gemini-2.5-flash

# Firebase Configuration
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
